<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if title %} | {% endif %}{{ site.name }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Open Graph / social sharing -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/images/brand/logo.jpg">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title or site.name }}">
  <meta name="twitter:description" content="{{ description or site.tagline }}">
  <meta name="twitter:image" content="{{ site.url }}/images/brand/logo.jpg">

  <link rel="icon" href="/images/brand/favicon.jpg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="banner">{{ site.banner }} &middot; <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></div>

  <header class="site-header">
    <a class="logo" href="/">
      <img src="/images/brand/logo.jpg" alt="{{ site.name }}" width="600" height="216">
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span>Menu</span>
    </button>
    <nav id="primary-nav" class="primary-nav">
      <ul>
        {% for item in site.nav %}
          {% if item.servicesDropdown %}
          <li class="has-dropdown">
            <button class="dropdown-toggle{% if page.url and '/services/' in page.url %} active{% endif %}" type="button" aria-expanded="false">{{ item.text }}</button>
            <ul class="dropdown">
              {% for service in services %}
              <li><a href="/services/{{ service.slug }}/">{{ service.navTitle or service.h1 }}</a></li>
              {% endfor %}
            </ul>
          </li>
          {% else %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p class="footer-name">{{ site.name }} &mdash; Registered Dietitian Nutritionists providing evidence-based, weight-inclusive care.</p>
    <p>Located in Cary, North Carolina.</p>
    <p>Serving {{ site.servingAreas }}.</p>
    <p>
      Phone: <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
      &nbsp;|&nbsp; Fax: {{ site.fax }}
      &nbsp;|&nbsp; Email: <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </p>
    <p class="footer-copyright">&copy; {{ year }} {{ site.name }}. All rights reserved.</p>
  </footer>

  <script src="/js/nav.js"></script>
</body>
</html>
